# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Public site URL (used for OAuth redirects and canonical URLs).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Analytics 4 measurement ID (optional).
# Leave blank in development so local traffic stays out of your reports.
NEXT_PUBLIC_GA_ID=

# Google Analytics Data API (for the analytics dashboard).
# Property ID and service account email have defaults in the code; only the
# private key must be set. Paste the whole key including the BEGIN/END lines.
GA4_PROPERTY_ID=547789591
GOOGLE_SERVICE_ACCOUNT_EMAIL=victorsdesk-analytics@victors-desk.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Kit (formerly ConvertKit) — newsletter delivery.
# Settings > Advanced > API. The key has full write access to your subscriber
# list, so keep it secret. Leave blank and signups still save to Supabase.
KIT_API_KEY=
KIT_FORM_ID=
